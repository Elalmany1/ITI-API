# Neon PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@ep-cool-example.us-east-1.neon.tech/neondb

# Optional: Vercel Blob Storage (for future use)
BLOB_READ_WRITE_TOKEN=

# API Configuration
NODE_ENV=production
VITE_API_BASE_URL=https://your-api-domain.vercel.app/api

# CORS Configuration
ALLOWED_ORIGINS=https://your-storefront-domain.vercel.app,https://your-admin-domain.vercel.app
